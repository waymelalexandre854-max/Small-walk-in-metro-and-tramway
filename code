import json
from collections import defaultdict

class TransportGraph:
    """
    Weighted directed graph stored as an adjacency list.
    Each node is a (station_name, line_id) tuple.
    """
    TRANSFER_TIME = 120  # seconds (same for all transfers)

    def __init__(self):
        self.adj: dict[tuple, list] = defaultdict(list) #defaultdict automatically initializes an empty list
        self.stations: set[str] = set()
        self.lines: dict[str, dict] = {}
        self.transfer_stations: dict[str, list] = {}  #key = station name, value= list of lines going through the station

    def load_from_json(self, filepath):
        """Read a city JSON file and build the graph structure."""
        try:
            with open(filepath, encoding="utf-8") as f:
                data = json.load(f)
        except FileNotFoundError:
            print(f"Error: file '{filepath}' not found.")
            return False
        except json.JSONDecodeError:
            print(f"Error: '{filepath}' is not valid JSON.")
            return False
        #Extract transit lines and default average time
        self.lines = data.get("lignes", data.get("lines", {}))
        default_time = data.get("temps_moyen", 90)

        # Ride edges (Consecutive stations)
        for line_id, line_data in self.lines.items():
            stations = line_data.get("stations", [])
            for i in range(len(stations) - 1):
                src, dst = stations[i], stations[i + 1]
                self.stations.add(src)
                self.stations.add(dst)
                u, v = (src, line_id), (dst, line_id)
                self.adj[u].append((v, default_time, "ride")) #forward and backward edges
                self.adj[v].append((u, default_time, "ride"))

        # Override with explicit connections
        for conn in data.get("connexions", data.get("connections", [])): #specific inter-station time
            src = conn["from"]
            dst = conn["to"]
            t = conn["time"]
            line = conn["line"]
            self.stations.add(src)
            self.stations.add(dst)
            u, v = (src, line), (dst, line)
            self.adj[u].append((v, t, "ride")) #custom time
            self.adj[v].append((u, t, "ride"))

        # Transfer edges (Correspondances)
        for transfer in data.get("correspondances", data.get("transfers", [])):
            station = transfer.get("station") or transfer.get("from")
            lines_at_station = transfer.get("lignes", transfer.get("lines", []))
            tt = transfer.get("temps", transfer.get("transfer_time", self.TRANSFER_TIME))

            if not station or not lines_at_station:
                continue
            #link all lines in a station
            for i, line_a in enumerate(lines_at_station):
                for line_b in lines_at_station[i + 1:]:
                    na, nb = (station, line_a), (station, line_b)
                    #creates a transfer edge if it exists in the active network
                    if na in self.adj or nb in self.adj:
                        self.adj[na].append((nb, tt, "transfer"))
                        self.adj[nb].append((na, tt, "transfer"))

            self.transfer_stations[station] = lines_at_station

        print(f"Loaded: {len(self.stations)} stations, {len(self.lines)} lines.")
        return True

    def all_nodes(self):
        nodes = set(self.adj.keys())
        for neighbours in self.adj.values():
            for nb, _, _ in neighbours:
                nodes.add(nb)
        return list(nodes)

    def nodes_for_station(self, station):
        return [n for n in self.all_nodes() if n[0] == station]


from collections import deque
# On assume que cette partie hérite ou complète la classe TransportGraph

def bfs(self, start, end):
    """Returns the path with fewest stops, or None if unreachable (O(V + E))."""
    visited: set[tuple] = set()
    queue: deque = deque()

    for sn in self.nodes_for_station(start):
        queue.append((sn, [start]))
        visited.add(sn)

    while queue:
        node, path = queue.popleft()
        if node[0] == end:
            return path
        for neighbour, _, _ in self.adj[node]:
            if neighbour not in visited:
                visited.add(neighbour)
                queue.append((neighbour, path + [neighbour[0]]))

    return None

def dfs(self, start):
    """Returns all physical stations reachable from start (iterative DFS)."""
    visited: set[tuple] = set()
    stack = list(self.nodes_for_station(start))

    while stack:
        node = stack.pop()
        if node in visited:
            continue
        visited.add(node)
        for neighbour, _, _ in self.adj[node]:
            if neighbour not in visited:
                stack.append(neighbour)

    return {n[0] for n in visited}

def is_fully_connected(self):
    """True if every station is reachable from any other station."""
    if not self.adj:
        return True
    start = next(iter(self.adj))[0]
    return self.dfs(start) == self.stations


import heapq             # for the priority queue 
from collections import defaultdict       # for initializing distances to infinity

def dijkstra(self, start, end):
    """Dijkstra's algorithm using priority queue to find fastest path."""
    INF = float("inf")
    dist: dict[tuple, float] = defaultdict(lambda: INF)  # All nodes start at infinite distance
    prev: dict[tuple, tuple | None] = {}  # Track path for reconstruction
    heap = []  # Priority queue: (cost, node)

    for sn in self.nodes_for_station(start):
        dist[sn] = 0
        prev[sn] = None
        heapq.heappush(heap, (0, sn))

    while heap:
        cost, node = heapq.heappop(heap)  # Always expand lowest-cost node first
        if node[0] == end:
            break
        if cost > dist[node]:
            continue  # Skip if we found a better path already
        for neighbour, weight, _ in self.adj[node]:
            new_cost = cost + weight
            if new_cost < dist[neighbour]:
                dist[neighbour] = new_cost  # Update distance
                prev[neighbour] = node  # Track path
                heapq.heappush(heap, (new_cost, neighbour))

    end_nodes = self.nodes_for_station(end)
    best = min(end_nodes, key=lambda n: dist[n], default=None)
    if best is None or dist[best] == INF:
        return None, None

    # Reconstruct path from end to start
    path, cur = [], best
    while cur is not None:
        path.append(cur)
        cur = prev.get(cur)
    path.reverse()

    return int(dist[best]), self._build_steps(path)

def _build_steps(self, path):
    """Convert node path to transit actions: board, ride, transfer, alight."""
    if not path:
        return []
    steps = [{"action": "board", "station": path[0][0], "line": path[0][1]}]

    for i in range(1, len(path)):
        prev_station, prev_line = path[i - 1]
        curr_station, curr_line = path[i]
        # Transfer if same station but different line
        if curr_station == prev_station and curr_line != prev_line:
            steps.append({"action": "transfer", "station": curr_station, "from_line": prev_line, "to_line": curr_line})
        else:
            steps.append({"action": "ride", "station": curr_station, "line": curr_line})

    steps[-1]["action"] = "alight"  # Last action is always alighting
    return steps


def format_time(seconds):
    """Converts seconds into a string with proper pluralization."""
    m, s = divmod(seconds, 60)
    if m == 0:
        return f"{s} second{'s' if s != 1 else ''}"
    if s == 0:
        return f"{m} minute{'s' if m != 1 else ''}"
    return f"{m} minute{'s' if m != 1 else ''} {s} second{'s' if s != 1 else ''}"

def print_route(steps, total_time):
    """Prints detailed itinerary: header, step-by-step actions, footer with total time."""
    print("\n  " + "─" * 50)  # Visual separator
    for step in steps:
        if step["action"] == "board":
            print(f"  🚉 Board at {step['station']}, line {step['line']}")
        elif step["action"] == "ride":
            print(f"     Continue through {step['station']}")
        elif step["action"] == "transfer":
            print(f"  🔄 Transfer at {step['station']}: line {step['from_line']} → line {step['to_line']}")
        elif step["action"] == "alight":
            print(f"  🏁 Alight at {step['station']}, line {step['line']}")
    print("  " + "─" * 50)
    print(f"  ⏱  Total time: {format_time(total_time)}\n")

def print_bfs_route(stations):
    """Prints BFS path with stop count and directional arrows between stations."""
    print(f"\n  BFS path ({len(stations) - 1} stop{'s' if len(stations) > 2 else ''}):")
    for i, s in enumerate(stations):
        prefix = "  🚉" if i == 0 else ("  🏁" if i == len(stations) - 1 else "     →")
        print(f"{prefix} {s}")
    print()
